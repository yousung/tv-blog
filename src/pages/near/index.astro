---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NearFinder from '../../components/NearFinder.astro';
import RegionLinks from '../../components/RegionLinks.astro';
import { getPublishedPosts } from '../../utils/posts';
import { buildPlaces } from '../../utils/places';

const places = buildPlaces(getPublishedPosts(await getCollection('posts')));
---

<BaseLayout
  title="내 주변 방송 맛집 찾기"
  description="현재 위치나 원하는 지역·역·주소를 기준으로 생생정보, 생방송 투데이, 오늘N 등 TV에 나온 맛집을 가까운 순서로 찾아보세요."
>
  <NearFinder places={places} autoLocate="always" pageSize={20} layout="full">
    <h1 class="nf-panel__title">내 주변 방송 맛집</h1>
  </NearFinder>

  <RegionLinks places={places} />
</BaseLayout>
