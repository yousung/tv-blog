---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NearFinder from '../components/NearFinder.astro';
import RegionLinks from '../components/RegionLinks.astro';
import { CATEGORY_LABELS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';
import { buildPlaces } from '../utils/places';

const posts = getPublishedPosts(await getCollection('posts'));
const places = buildPlaces(posts);
const latest = posts.slice(0, 6);
const categoryCounts = Object.keys(CATEGORY_LABELS)
  .map((key) => ({
    key,
    label: CATEGORY_LABELS[key],
    count: posts.filter((post) => post.data.category === key).length
  }))
  .filter((category) => category.count > 0);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="near-intro">
    <h1>TV에 나온 맛집, 지도에서 바로 찾기</h1>
    <p>생생정보·생방송 투데이·6시 내고향·오늘N에 나온 맛집 {places.length}곳. 내 위치나 놀러 갈 지역을 고르면 가까운 순으로 보여 드려요.</p>
  </section>

  <NearFinder places={places} autoLocate="granted" pageSize={12} />

  <RegionLinks places={places} />

  <section aria-labelledby="latest-title">
    <div class="section-head">
      <div>
        <h2 id="latest-title">최신 방송 정리</h2>
        <p>최근 방송에 나온 곳부터 정리했습니다.</p>
      </div>
      <a class="button" href="/programs/">프로그램별 보기</a>
    </div>
    {latest.length ? (
      <div class="grid two">
        {latest.map((post) => <PostCard post={post} compact />)}
      </div>
    ) : (
      <p class="empty">아직 발행된 방송 글이 없습니다.</p>
    )}
  </section>

  <section aria-labelledby="category-title">
    <div class="section-head">
      <div>
        <h2 id="category-title">카테고리</h2>
      </div>
    </div>
    <div class="category-strip">
      {categoryCounts.map((category) => (
        <a class="category-card" href={`/categories/${category.key}/`}>
          <strong>{category.label}</strong>
          <span>{category.count}개 글</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
